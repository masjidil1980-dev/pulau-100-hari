{"fps": 30, "duration": 145.53, "shots": [{"key": "d1", "start": 0.0, "end": 1.386, "words": 2, "text": "Hari pertama...", "wt": [[0.0, 0.545], [0.545, 1.386]]}, {"key": "sunyi", "start": 2.149, "end": 10.618, "words": 21, "text": "Lihatlah tempat ini... Tidak ada suara burung... Tidak ada gemerisik daun... Yang ada hanyalah angin kering, debu, dan bebatuan yang membisu...", "wt": [[2.149, 2.586], [2.586, 2.931], [2.931, 3.138], [3.138, 4.104], [4.104, 4.311], [4.311, 4.61], [4.61, 4.955], [4.955, 5.254], [5.254, 5.978], [5.978, 6.461], [6.461, 6.714], [6.714, 6.967], [6.967, 7.174], [7.174, 8.129], [8.129, 8.428], [8.428, 8.773], [8.773, 9.026], [9.026, 9.233], [9.233, 9.67], [9.67, 10.227], [10.227, 10.618]]}, {"key": "mati", "start": 10.866, "end": 17.852, "words": 17, "text": "Bagi kebanyakan orang... pulau ini hanyalah seonggok tanah mati di tengah lautan luas. Tempat yang ditinggalkan waktu.", "wt": [[10.866, 11.138], [11.138, 11.706], [11.706, 12.027], [12.027, 12.895], [12.895, 13.117], [13.117, 13.587], [13.587, 14.056], [14.056, 14.764], [14.764, 15.036], [15.036, 15.209], [15.209, 15.579], [15.579, 15.95], [15.95, 16.222], [16.222, 16.592], [16.592, 16.864], [16.864, 17.531], [17.531, 17.852]]}, {"key": "ubah", "start": 18.361, "end": 21.327, "words": 6, "text": "Tapi hari ini semuanya akan berubah!", "wt": [[18.361, 18.712], [18.712, 19.064], [19.064, 19.351], [19.351, 20.433], [20.433, 20.784], [20.784, 21.327]]}, {"key": "misi", "start": 21.573, "end": 31.566, "words": 22, "text": "Misi saya sederhana, namun terdengar mustahil. Dalam seratus hari ke depan... saya akan mengubah pulau tandus ini menjadi sebuah kehidupan yang nyata!", "wt": [[21.573, 21.896], [21.896, 22.218], [22.218, 22.835], [22.835, 23.55], [23.55, 24.166], [24.166, 24.723], [24.723, 25.104], [25.104, 25.603], [25.603, 25.926], [25.926, 26.406], [26.406, 26.788], [26.788, 27.111], [27.111, 27.433], [27.433, 28.221], [28.221, 28.603], [28.603, 29.043], [29.043, 29.307], [29.307, 29.805], [29.805, 30.246], [30.246, 30.862], [30.862, 31.184], [31.184, 31.566]]}, {"key": "nol", "start": 31.901, "end": 43.566, "words": 33, "text": "Langkah pertama dimulai di titik nol ini. Sebelum kita bicara tentang hutan yang rimbun, sebelum kita membangun rumah, atau mengundang kehidupan lain datang ke sini... kita butuh satu hal yang paling mendasar... Air.", "wt": [[31.901, 32.302], [32.302, 32.703], [32.703, 33.105], [33.105, 33.27], [33.27, 33.577], [33.577, 33.79], [33.79, 34.002], [34.002, 34.771], [34.771, 35.031], [35.031, 35.385], [35.385, 35.787], [35.787, 36.094], [36.094, 36.353], [36.353, 36.707], [36.707, 37.317], [37.317, 37.577], [37.577, 38.073], [38.073, 38.38], [38.38, 38.897], [38.897, 39.44], [39.44, 39.936], [39.936, 40.196], [40.196, 40.55], [40.55, 40.715], [40.715, 40.975], [40.975, 41.512], [41.512, 41.819], [41.819, 42.079], [42.079, 42.291], [42.291, 42.551], [42.551, 42.905], [42.905, 43.354], [43.354, 43.566]]}, {"key": "kubur", "start": 44.045, "end": 49.952, "words": 15, "text": "Tanpa air, tanah ini akan selamanya menjadi kuburan bagi benih apa pun yang kita tanam.", "wt": [[44.045, 44.404], [44.404, 45.121], [45.121, 45.481], [45.481, 45.729], [45.729, 46.305], [46.305, 46.886], [46.886, 47.355], [47.355, 47.825], [47.825, 48.129], [48.129, 48.488], [48.488, 48.737], [48.737, 48.985], [48.985, 49.289], [49.289, 49.593], [49.593, 49.952]]}, {"key": "lereng", "start": 50.362, "end": 58.576, "words": 20, "text": "Saya mulai menyusuri lereng bukit batu di bagian utara. Panasnya menyengat... tanahnya retak-retak seolah sudah puluhan tahun tidak menyentuh hujan...", "wt": [[50.362, 50.629], [50.629, 50.945], [50.945, 51.455], [51.455, 51.82], [51.82, 52.136], [52.136, 52.403], [52.403, 52.573], [52.573, 52.938], [52.938, 53.253], [53.253, 54.086], [54.086, 54.597], [54.597, 55.466], [55.466, 56.025], [56.025, 56.389], [56.389, 56.705], [56.705, 57.118], [57.118, 57.434], [57.434, 57.75], [57.75, 58.26], [58.26, 58.576]]}, {"key": "harap", "start": 58.894, "end": 69.35, "words": 30, "text": "Namun, di balik tumpukan batu karang yang keras ada tanda harapan... Tanah di sekitar sini terasa sedikit lembap! Artinya, ada jalur mata air yang terperangkap di bawah permukaan batu ini.", "wt": [[58.894, 59.21], [59.21, 59.381], [59.381, 59.697], [59.697, 60.16], [60.16, 60.428], [60.428, 60.793], [60.793, 61.061], [61.061, 61.377], [61.377, 61.825], [61.825, 62.142], [62.142, 62.556], [62.556, 63.195], [63.195, 63.366], [63.366, 63.78], [63.78, 64.047], [64.047, 64.413], [64.413, 64.826], [64.826, 65.504], [65.504, 65.918], [65.918, 66.137], [66.137, 66.453], [66.453, 66.721], [66.721, 66.94], [66.94, 67.208], [67.208, 67.865], [67.865, 68.036], [68.036, 68.352], [68.352, 68.864], [68.864, 69.131], [69.131, 69.35]]}, {"key": "gali", "start": 69.702, "end": 77.508, "words": 19, "text": "Dengan peralatan seadanya, penggalian pertama pun dimulai! Satu demi satu batu disingkirkan... peluh mulai menetes membasahi tanah kering ini...", "wt": [[69.702, 70.077], [70.077, 70.603], [70.603, 71.078], [71.078, 71.653], [71.653, 72.078], [72.078, 72.304], [72.304, 72.955], [72.955, 73.23], [73.23, 73.505], [73.505, 73.781], [73.781, 74.056], [74.056, 74.731], [74.731, 75.306], [75.306, 75.631], [75.631, 76.057], [76.057, 76.582], [76.582, 76.907], [76.907, 77.282], [77.282, 77.508]]}, {"key": "tetes", "start": 77.789, "end": 80.585, "words": 6, "text": "Dan akhirnya... Tetesan pertama itu muncul!", "wt": [[77.789, 78.05], [78.05, 78.603], [78.603, 79.393], [79.393, 79.887], [79.887, 80.149], [80.149, 80.585]]}, {"key": "sungai", "start": 80.916, "end": 91.707, "words": 24, "text": "Perlahan tapi pasti, air jernih mulai mengalir, mencari jalannya sendiri menuruni lembah... membentuk aliran sungai kecil yang untuk pertama kalinya membelah kesunyian pulau ini...", "wt": [[80.916, 81.428], [81.428, 81.725], [81.725, 82.076], [82.076, 82.319], [82.319, 82.95], [82.95, 83.301], [83.301, 83.813], [83.813, 84.553], [84.553, 85.066], [85.066, 85.525], [85.525, 86.038], [86.038, 86.442], [86.442, 87.308], [87.308, 87.713], [87.713, 88.117], [88.117, 88.468], [88.468, 88.765], [88.765, 89.116], [89.116, 89.575], [89.575, 90.033], [90.033, 90.546], [90.546, 91.113], [91.113, 91.464], [91.464, 91.707]]}, {"key": "refleksi", "start": 92.104, "end": 97.784, "words": 16, "text": "Hari pertama belum menghasilkan hutan. Belum ada rumah, dan belum ada kehidupan yang berlarian di sini.", "wt": [[92.104, 92.376], [92.376, 92.798], [92.798, 93.12], [93.12, 93.789], [93.789, 94.111], [94.111, 94.71], [94.71, 94.933], [94.933, 95.255], [95.255, 95.478], [95.478, 95.801], [95.801, 96.024], [96.024, 96.544], [96.544, 96.817], [96.817, 97.337], [97.337, 97.511], [97.511, 97.784]]}, {"key": "detak", "start": 98.041, "end": 102.319, "words": 12, "text": "Tapi aliran air kecil ini adalah detak jantung pertama bagi pulau ini!", "wt": [[98.041, 98.335], [98.335, 98.737], [98.737, 98.978], [98.978, 99.326], [99.326, 99.567], [99.567, 100.177], [100.177, 100.525], [100.525, 100.98], [100.98, 101.435], [101.435, 101.73], [101.73, 102.078], [102.078, 102.319]]}, {"key": "seratus", "start": 102.674, "end": 105.507, "words": 6, "text": "Perjalanan seratus hari baru saja dimulai...", "wt": [[102.674, 103.398], [103.398, 103.933], [103.933, 104.279], [104.279, 104.626], [104.626, 104.972], [104.972, 105.507]]}, {"key": "alir", "start": 105.889, "end": 110.351, "words": 13, "text": "Air sudah mengalir... Tapi pulau ini masih membutuhkan banyak hal untuk benar-benar hidup.", "wt": [[105.889, 106.095], [106.095, 106.392], [106.392, 106.827], [106.827, 107.309], [107.309, 107.607], [107.607, 107.812], [107.812, 108.11], [108.11, 108.681], [108.681, 109.025], [109.025, 109.23], [109.23, 109.528], [109.528, 110.054], [110.054, 110.351]]}, {"key": "nasib", "start": 110.602, "end": 113.622, "words": 9, "text": "Dan di sinilah kalian ikut menentukan nasib pulau ini!", "wt": [[110.602, 110.834], [110.834, 111.015], [111.015, 111.454], [111.454, 111.841], [111.841, 112.125], [112.125, 112.719], [112.719, 113.054], [113.054, 113.39], [113.39, 113.622]]}, {"key": "tanya", "start": 113.923, "end": 119.35, "words": 15, "text": "Untuk hari kedua nanti... apa langkah pertama yang harus saya lakukan dengan sumber air ini?", "wt": [[113.923, 114.251], [114.251, 114.528], [114.528, 114.856], [114.856, 115.454], [115.454, 115.681], [115.681, 116.11], [116.11, 116.538], [116.538, 116.816], [116.816, 117.143], [117.143, 117.421], [117.421, 117.85], [117.85, 118.228], [118.228, 118.896], [118.896, 119.123], [119.123, 119.35]]}, {"key": "pil1", "start": 119.583, "end": 127.242, "words": 21, "text": "Pilihan pertama... Mulai menanam bibit pohon dan rumput di sekitar aliran sungai, agar tanah kering ini perlahan berubah menjadi hutan hijau.", "wt": [[119.583, 120.01], [120.01, 120.437], [120.437, 120.763], [120.763, 121.19], [121.19, 121.516], [121.516, 121.842], [121.842, 122.068], [122.068, 122.445], [122.445, 122.621], [122.621, 123.048], [123.048, 123.424], [123.424, 123.801], [123.801, 124.077], [124.077, 124.403], [124.403, 124.78], [124.78, 125.006], [125.006, 125.483], [125.483, 126.162], [126.162, 126.589], [126.589, 126.916], [126.916, 127.242]]}, {"key": "pil2", "start": 127.699, "end": 137.064, "words": 21, "text": "Atau pilihan kedua... Membangun bendungan kecil dan tempat penampungan air, agar kita punya cadangan air yang cukup sebelum musim panas tiba.", "wt": [[127.699, 128.017], [128.017, 128.509], [128.509, 128.885], [128.885, 129.493], [129.493, 130.101], [130.101, 130.477], [130.477, 131.127], [131.127, 131.561], [131.561, 132.285], [132.285, 132.545], [132.545, 132.863], [132.863, 133.182], [133.182, 133.558], [133.558, 134.108], [134.108, 134.368], [134.368, 134.686], [134.686, 135.501], [135.501, 135.993], [135.993, 136.37], [136.37, 136.746], [136.746, 137.064]]}, {"key": "komen", "start": 137.283, "end": 142.716, "words": 19, "text": "Tulis pilihan kalian di kolom komentar... satu, atau dua! Suara terbanyak akan menentukan apa yang terjadi di hari kedua.", "wt": [[137.283, 137.544], [137.544, 137.885], [137.885, 138.186], [138.186, 138.327], [138.327, 138.587], [138.587, 139.365], [139.365, 139.585], [139.585, 139.806], [139.806, 139.987], [139.987, 140.248], [140.248, 140.669], [140.669, 140.89], [140.89, 141.351], [141.351, 141.532], [141.532, 141.753], [141.753, 142.094], [142.094, 142.234], [142.234, 142.455], [142.455, 142.716]]}, {"key": "pamit", "start": 143.106, "end": 144.723, "words": 3, "text": "Sampai jumpa besok...", "wt": [[143.106, 143.698], [143.698, 144.21], [144.21, 144.723]]}]}